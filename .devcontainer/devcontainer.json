// このファイルは、ローカル側(Mac側)で動作している devcontainer 拡張が読み込む設定ファイル。
// devcontainer 拡張はこの内容に従って、
//   1. dockerComposeFile / service で指定したコンテナをビルド・起動し、
//   2. そこへ VS Code Server を送り込んで remoteUser の権限で起動し、
//   3. workspaceFolder を開き、postCreateCommand と customizations を適用する。
{
  "name": "recipe-api-devcontainer",
  "dockerComposeFile": "docker-compose.yml",
  "service": "backend",
  "workspaceFolder": "/workspaces/cc-dev-container",
  // remoteUser: コンテナ内で「VS Code Server」本体（およびそこから生まれる子プロセスの
  // ターミナル・言語サーバーなど）をどのユーザー権限で動かすかを指定する設定。
  // (省略した場合は Dockerfile の USER（未指定なら root）が使われる。)
  //
  // 1. コンテナ起動後、devcontainer拡張（ローカル側で動く拡張機能）が
  //    docker exec -u <remoteUser> ... で「VS Code Server」というNode.jsプログラムを
  //    コンテナ内に送り込み、remoteUser の権限で起動する。
  // 2. その後、コンテナ内のターミナル（bash など）や言語サーバー（Python/TypeScript拡張機能）は、
  //    外部から dockerd が都度送り込むのではなく、コンテナ内で動いている
  //    VS Code Server のサブプロセスとして起動する。
  "remoteUser": "node",

  // コンテナ作成後(初回コンテナ作成時と、rebuildした時)に実行される。
  // ~/.claude/settings.json に .devcontainer/statusline-command.sh を登録する。
  "postCreateCommand": "sh .devcontainer/setup-statusline.sh",

  // features は、 VS Code + devcontainer拡張での構成、または、 Dev Container CLI
  // (CI等でも単体で使われる)でのビルド時にしか動かないので、ここでは使っていない。
  // 素の docker compose up でも同じ環境になるよう、
  // Claude Code CLI 含む全ツールのインストールは Dockerfile に直書きしている。
  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.enableVisualBell": true,
        "accessibility.signals.terminalBell": {
          "sound": "on"
        }
      },
      "extensions": [
        "anthropic.claude-code",
        "ms-python.python",
        "charliermarsh.ruff",
        "ms-azuretools.vscode-docker",
        "qwtel.sqlite-viewer",
        "njpwerner.autodocstring",
        "streetsidesoftware.code-spell-checker",
        "dbaeumer.vscode-eslint",
        "tamasfe.even-better-toml",
        "google.gemini-cli-vscode-ide-companion",
        "eamodio.gitlens",
        "oderwat.indent-rainbow",
        "christian-kohler.path-intellisense",
        "esbenp.prettier-vscode",
        "vue.volar",
        "bradlc.vscode-tailwindcss",
        "mechatroner.rainbow-csv",
        "formulahendry.auto-rename-tag"
      ]
    }
  }
}