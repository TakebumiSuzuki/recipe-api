#!/bin/sh

# ==============================================================================
# 【Gitフックの基本仕様メモ】
# 1. フォルダ名 (.githooks) について
#    - デフォルトの .git/hooks では Git管理（コミット共有）ができないため、リポジトリで
#      共有できるよう `git config core.hooksPath .githooks` でこのフォルダパスに設定
# 2. ファイル名 (pre-commit) について
#    - コミット直前に自動実行させるための、Git仕様で定められた固定の名前（拡張子は不要）。
# 3. 記述言語について
#    - 実行権限 (chmod +x) と先頭のシバン (例: #!/usr/bin/env python3) があれば、
#      シェルスクリプトに限らず Python など任意の言語で記述・実行可能。
# 4. 実行のされ方について
#    - Git はOS(カーネル)に直接、このファイルを実行して、と依頼する（fork / execve）
#      (= システムコール)
#      [git] --execve(".githooks/pre-commit")--> [カーネル] --> /bin/sh がファイルを実行
#            ↑ここがシステムコール（アプリの世界とOSの世界の境界）
# ==============================================================================

echo "pre-commit hook triggered"

# 1. ステージングされたPythonファイルの一括取得
#    - git diff の詳細については git-diff.mdを参照
#    - コマンド置換 $(...)   : 完了を待って結果のファイル名一覧を一括で FILES 変数に格納
#                            （※sh には配列がないため、改行区切りの「単一文字列」として保持される）
FILES=$(git diff --staged --name-only --diff-filter=ACMR "*.py")

# 2. 対象ファイルが存在する場合のみフォーマットと再ステージングを実行
#    - [ -n "$FILES" ] : -n (nonzero) は「文字列が空ではないか」を判定
#    - $FILES の展開    : クォートなし ($FILES) で参照することで、改行が自動分割され
#                        各コマンド (ruff, git) に複数の引数として渡される
if [ -n "$FILES" ]; then
    echo "Ruff: Formatting staged files..."
    uv run ruff format $FILES
    git add $FILES
fi

# エラーチェックは一切せず、100% 成功させてコミットを通す！
exit 0